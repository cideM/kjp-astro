<% layout("./page.eta", { siteTitle: it.siteTitle, navigation: it.navigation, footer: it.footer }) %>
<main class="content-width text-align:center stack">
  <h1>Praxis</h1>
  <section class="praxis-gallery cluster content-width justify-content:center">
    <% for (const image of it.carouselImages) { %>
    <a href="<%= image.url %>">
      <picture>
        <source
          type="image/webp"
          sizes="(min-width: 600px) 300px, calc(50vw - 24px)"
          srcset="
            <%= image.url %>?q=75&w=200&h=200&fm=webp&fit=fill 200w,
            <%= image.url %>?q=75&w=300&h=300&fm=webp&fit=fill 300w,
            <%= image.url %>?q=80&w=450&h=450&fm=webp&fit=fill 450w,
            <%= image.url %>?q=80&w=600&h=600&fm=webp&fit=fill 600w"
        />
        <img
          src="<%= image.url %>?w=300&h=300&fit=fill"
          alt="<%= image.alt %>"
          width="300"
          height="300"
          loading="lazy"
          sizes="(min-width: 600px) 300px, calc(50vw - 24px)"
          srcset="
            <%= image.url %>?q=75&w=200&h=200&fit=fill 200w,
            <%= image.url %>?q=75&w=300&h=300&fit=fill 300w,
            <%= image.url %>?q=80&w=450&h=450&fit=fill 450w,
            <%= image.url %>?q=80&w=600&h=600&fit=fill 600w"
        />
      </picture>
    </a>
    <% } %>
  </section>
</main>
