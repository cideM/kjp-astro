<% layout("./page.eta", { siteTitle: it.siteTitle, navigation: it.navigation, footer: it.footer }) %>
<link rel="stylesheet" href="/vendor/swiper.min.css" />

<div class="swiper">
  <div class="swiper-wrapper">
    <% for (const image of it.carouselImages) { %>
    <div class="swiper-slide">
      <picture>
        <source
          type="image/webp"
          sizes="100vw"
          srcset="
            <%= image.url %>?q=70&w=600&h=257&fm=webp&fit=fill 600w,
            <%= image.url %>?q=75&w=1200&h=514&fm=webp&fit=fill 1200w,
            <%= image.url %>?q=80&w=1800&h=771&fm=webp&fit=fill 1800w,
            <%= image.url %>?q=80&w=2600&h=800&fm=webp&fit=fill 2600w"
        />
        <img
          src="<%= image.url %>?w=1200&h=514&fit=fill"
          alt="<%= image.alt %>"
          loading="lazy"
          sizes="100vw"
          srcset="
            <%= image.url %>?q=70&w=600&h=257&fit=fill 600w,
            <%= image.url %>?q=75&w=1200&h=514&fit=fill 1200w,
            <%= image.url %>?q=80&w=1800&h=771&fit=fill 1800w,
            <%= image.url %>?q=80&w=2600&h=800&fit=fill 2600w"
        />
      </picture>
    </div>
    <% } %>
  </div>
  <div class="swiper-pagination"></div>
</div>

<main class="stack welcome-section">
  <article class="with-sidebar content-width">
    <div class="roundPicture">
      <picture>
        <source
          type="image/webp"
          sizes="250px"
          srcset="
            <%= it.sonjaFotoUrl %>?q=75&w=250&h=250&fm=webp&fit=fill 250w,
            <%= it.sonjaFotoUrl %>?q=80&w=500&h=500&fm=webp&fit=fill 500w,
            <%= it.sonjaFotoUrl %>?q=80&w=750&h=750&fm=webp&fit=fill 750w"
        />
        <img
          src="<%= it.sonjaFotoUrl %>?w=250&h=250&fit=fill"
          width="250"
          height="250"
          alt="Dr. Sonja Könnecke"
          class="center"
          sizes="250px"
          srcset="
            <%= it.sonjaFotoUrl %>?q=75&w=250&h=250&fit=fill 250w,
            <%= it.sonjaFotoUrl %>?q=80&w=500&h=500&fit=fill 500w,
            <%= it.sonjaFotoUrl %>?q=80&w=750&h=750&fit=fill 750w"
        />
      </picture>
    </div>
    <div class="stack-s">
      <%~ it.willkommensHtml %>
    </div>
  </article>
</main>

<script src="/vendor/swiper.min.js"></script>
<script>
  new Swiper(".swiper", {
    autoplay: {
      delay: 3000,
    },
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
    speed: 1000,
    loop: true,
  });
</script>
